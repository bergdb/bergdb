      intro _ w10 ⟨h10top, _, h10v, h10t, h10l, pn10, h10p, h10leaf, h10times, h10iff⟩
      try simp only [writerWP_pure]
      have h10tc : ∀ y, y ≠ l → y ≠ r → w10.taken.contains y = w3.taken.contains y := by
