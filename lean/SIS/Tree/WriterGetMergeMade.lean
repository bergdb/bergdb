        intro y hyp hyl hyr; rw [h10l y hyp (hcl' _ _ y hyl hyr), h9n, lookup_upsert]; simp [hyp]
      have hm2T : w3.taken.contains (m1 + 2) = false := (hfree _ (by omega)).2
      have h10v' : w10.vals = w3.vals := by rw [h10v, h9v, h8v, h7v, h6v, h5v, h4v]
