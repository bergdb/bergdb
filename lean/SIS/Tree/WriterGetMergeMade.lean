/-
The writer's merge keeps every reading also for nodes the transaction made
(bergdb 024-12, TP10's `OpGetOK`; 024-22): the parent's klongs of the
transaction that name a merged node made by it are retargeted to the new node,
which none live of them does after the merge, so the parent's live klongs are
kept; the merged nodes are taken back, and had no value
(`writerWP_mergeTail_made_get`, `writerWP_merge_made_get`).
-/
import SIS.Tree.WriterGetMergeTail
import SIS.Tree.WriterTreeMergeMade

set_option autoImplicit false

namespace SIS.Tree

open SIS SIS.Check

/-- A node retargeted keeps every live klong that does not name the source. -/
theorem KNode.retarget_liveAt_of (n : KNode) (ti : Nat) (src dst : NodeId) (t : Time) (c : Nat)
    (z : NodeId) (h : (c, z) ∈ n.liveAt t) (hz : z ≠ src) :
    (c, z) ∈ ({ n with ks := retargetKlongs n.ks ti src dst } : KNode).liveAt t := by
  have hp : ∀ q, (fun k => match k with
      | Klong.time x => decide (x ≤ t)
      | _ => true) (retargetStep ti src dst q) = (fun k => match k with
      | Klong.time x => decide (x ≤ t)
      | _ => true) q.1 := by
    intro q
    rcases q with ⟨k, i⟩
    cases k with
    | key cv y =>
      by_cases hc : (decide (ti < i) && y == src) = true
      · simp only [retargetStep, hc, ↓reduceIte]
      · simp only [retargetStep, hc, Bool.false_eq_true, ↓reduceIte]
    | time u => rfl
    | del b => rfl
  have hpre : prefixAt (retargetKlongs n.ks ti src dst) t =
      ((prefixAt n.ks t).zipIdx).map (retargetStep ti src dst) := by
    rw [retargetKlongs_eq]
    unfold prefixAt
    exact takeWhile_zipIdx_map _ _ hp n.ks 0
  have hdel : ({ n with ks := retargetKlongs n.ks ti src dst } : KNode).delAt t = n.delAt t := by
    unfold KNode.delAt
    simp only
    rw [hpre]
    unfold lastBitmapOf
    exact lastBitmapOf_zipIdx_map ti src dst _ 0 []
  have hl := lookup_of_mem_nodup _ (KNode.liveAt_keys_nodup n t) c z h
  rw [KNode.liveAt_lookup] at hl
  apply mem_of_lookup_nodup _ c z
  rw [KNode.liveAt_lookup]
  simp only
  rw [hpre, hdel]
  unfold keyLookup at hl ⊢
  rw [zipIdx_map_zipIdx]
  rcases keyLookupFold_retarget (n.delAt t) c ti src dst _ none none (Or.inl rfl) with h1 | ⟨h1, h2⟩
  · rw [h1]; exact hl
  · rw [hl] at h1
    simp only [Option.some.injEq] at h1
    exact absurd h1 hz

/-- A node retargeted keeps its leaf flag and its time klongs. -/
theorem KNode.retarget_times (n : KNode) (ti : Nat) (src dst : NodeId) (t : Time)
    (h : ∀ s, Klong.time s ∈ n.ks → s ≤ t) :
    ∀ s, Klong.time s ∈ (retargetKlongs n.ks ti src dst) → s ≤ t := by
  intro s hs
  rw [retargetKlongs_eq, List.mem_map] at hs
  obtain ⟨q, hq, hqs⟩ := hs
  have h1 := (retargetStep_time ti src dst q s).mp hqs
  apply h s
  have : q.1 ∈ n.ks := List.mem_of_getElem? (List.mem_zipIdx_iff_getElem?.mp hq)
  rw [← h1]; exact this

theorem writerWP_retarget_frameV (p src dst : NodeId) (n : KNode) (c : Ctx) (w : W)
    (hlk : w.nodes.lookup p = some n) :
    WriterWP (retarget p src dst) c w (fun _ w' => w'.taken = w.taken ∧ w'.top = w.top ∧
      w'.next = w.next ∧ w'.vals = w.vals ∧ (∀ y, y ≠ p → w'.nodes.lookup y = w.nodes.lookup y) ∧
      ∃ n', w'.nodes.lookup p = some n' ∧
        (n' = n ∨ ∃ ti, n' = { n with ks := retargetKlongs n.ks ti src dst })) := by
  unfold retarget
  simp only [writerWP_bind, writerWP_read]
  rw [writerWP_getNode_known p n c w hlk]
  split
  · unfold putNode
    refine (writerWP_modify _ c w _).mpr ?_
    have hrk : ∃ n' : KNode, n' = { n with ks := retargetKlongs n.ks (n.lastTimeIndex.getD 0) src dst } :=
      ⟨_, rfl⟩
    obtain ⟨n', hn'⟩ := hrk
    refine ⟨rfl, rfl, rfl, rfl, fun y hy => ?_, n', ?_, Or.inr ⟨_, hn'⟩⟩
    · show (upsert w.nodes p _).lookup y = _
      rw [lookup_upsert]; simp [hy]
    · show (upsert w.nodes p _).lookup p = _
      rw [lookup_upsert, hn']; simp only [↓reduceIte]; rfl
  · refine (writerWP_pure _ c w _).mpr ?_
    exact ⟨rfl, rfl, rfl, rfl, fun _ _ => rfl, n, hlk, Or.inl rfl⟩

/-- `writerWP_mergeCleanup_frame` with the values kept and the parent's live
klongs exactly kept (none names a node of the list). -/
theorem writerWP_mergeCleanup_frameV (p m1 : NodeId) (t : Time) (c : Ctx) :
    ∀ (xs : List (NodeId × Bool)) (w : W) (n : KNode), (∀ q ∈ xs, q.1 ≠ p) →
    w.nodes.lookup p = some n → (∀ q ∈ xs, ∀ c', (c', q.1) ∉ n.liveAt t) →
    WriterWP (forIn xs PUnit.unit (fun q _ => if q.2 = true then (do
        retarget p q.1 m1
        takenBack q.1
        note "merge.takeback"
        pure (ForInStep.yield PUnit.unit)) else (do
        unlink q.1
        pure (ForInStep.yield PUnit.unit)))) c w
      (fun _ w' => w'.top = w.top ∧ w'.next = w.next ∧ w'.vals = w.vals ∧
        (∀ y, (∀ q ∈ xs, y ≠ q.1) → w'.taken.contains y = w.taken.contains y) ∧
        (∀ y, y ≠ p → (∀ q ∈ xs, y ≠ q.1) → w'.nodes.lookup y = w.nodes.lookup y) ∧
        ∃ n', w'.nodes.lookup p = some n' ∧ n'.leaf = n.leaf ∧
          ((∀ s, Klong.time s ∈ n.ks → s ≤ t) → ∀ s, Klong.time s ∈ n'.ks → s ≤ t) ∧
          ∀ c' z, (c', z) ∈ n'.liveAt t ↔ (c', z) ∈ n.liveAt t) := by
  intro xs
  induction xs with
  | nil =>
    intro w n _ hlk _
    rw [List.forIn_nil]
    refine (writerWP_pure _ c w _).mpr ?_
    exact ⟨rfl, rfl, rfl, fun _ _ => rfl, fun _ _ _ => rfl, n, hlk, rfl, fun h => h,
      fun _ _ => Iff.rfl⟩
  | cons q qs ih =>
    intro w n hne hlk hno
    rw [List.forIn_cons]
    have hqp : q.1 ≠ p := hne q List.mem_cons_self
    have hrest : ∀ (w1 : W) (n1 : KNode), w1.top = w.top → w1.next = w.next → w1.vals = w.vals →
        (∀ y, y ≠ q.1 → w1.taken.contains y = w.taken.contains y) →
        (∀ y, y ≠ p → y ≠ q.1 → w1.nodes.lookup y = w.nodes.lookup y) →
        w1.nodes.lookup p = some n1 → n1.leaf = n.leaf →
        ((∀ s, Klong.time s ∈ n.ks → s ≤ t) → ∀ s, Klong.time s ∈ n1.ks → s ≤ t) →
        (∀ c' z, (c', z) ∈ n1.liveAt t ↔ (c', z) ∈ n.liveAt t) →
        WriterWP (forIn qs PUnit.unit (fun q _ => if q.2 = true then (do
          retarget p q.1 m1
          takenBack q.1
          note "merge.takeback"
          pure (ForInStep.yield PUnit.unit)) else (do
          unlink q.1
          pure (ForInStep.yield PUnit.unit)))) c w1
        (fun _ w' => w'.top = w.top ∧ w'.next = w.next ∧ w'.vals = w.vals ∧
          (∀ y, (∀ q' ∈ q :: qs, y ≠ q'.1) → w'.taken.contains y = w.taken.contains y) ∧
          (∀ y, y ≠ p → (∀ q' ∈ q :: qs, y ≠ q'.1) → w'.nodes.lookup y = w.nodes.lookup y) ∧
          ∃ n', w'.nodes.lookup p = some n' ∧ n'.leaf = n.leaf ∧
            ((∀ s, Klong.time s ∈ n.ks → s ≤ t) → ∀ s, Klong.time s ∈ n'.ks → s ≤ t) ∧
            ∀ c' z, (c', z) ∈ n'.liveAt t ↔ (c', z) ∈ n.liveAt t) := by
      intro w1 n1 h1top h1next h1v h1t h1l h1p h1leaf h1times h1iff
      refine writerWP_mono (ih w1 n1 (fun q' hq' => hne q' (List.mem_cons_of_mem _ hq')) h1p
        (fun q' hq' c' hm => hno q' (List.mem_cons_of_mem _ hq') c' ((h1iff _ _).mp hm))) ?_
      intro _ w2 ⟨h2top, h2next, h2v, h2t, h2l, n2, h2p, h2leaf, h2times, h2iff⟩
      refine ⟨h2top.trans h1top, h2next.trans h1next, h2v.trans h1v, fun y hy => ?_,
        fun y hyp hy => ?_, n2, h2p, h2leaf.trans h1leaf, fun ht => h2times (h1times ht),
        fun c' z => (h2iff c' z).trans (h1iff c' z)⟩
      · rw [h2t y (fun q' hq' => hy q' (List.mem_cons_of_mem _ hq')),
          h1t y (hy q List.mem_cons_self)]
      · rw [h2l y hyp (fun q' hq' => hy q' (List.mem_cons_of_mem _ hq')),
          h1l y hyp (hy q List.mem_cons_self)]
    by_cases hq2 : q.2 = true
    · simp only [writerWP_bind, hq2, ↓reduceIte]
      refine writerWP_mono (writerWP_retarget_frameV p q.1 m1 n c w hlk) ?_
      intro _ w1 ⟨h1t, h1top, h1next, h1v, h1l, n1, h1p, h1n⟩
      refine (writerWP_takenBack_iff _ c w1 _).mpr ?_
      refine (writerWP_note_iff _ c _ _).mpr ?_
      refine (writerWP_pure _ c _ _).mpr ?_
      dsimp only
      refine hrest _ n1 h1top h1next h1v ?_ ?_ h1p ?_ ?_ ?_
      · intro y hy
        show (q.1 :: w1.taken).contains y = _
        rw [List.contains_cons, h1t]
        have : (y == q.1) = false := by simpa using hy
        simp [this]
      · intro y hyp _; exact h1l y hyp
      · rcases h1n with he | ⟨ti, he⟩ <;> rw [he]
      · intro ht
        rcases h1n with he | ⟨ti, he⟩ <;> rw [he]
        · exact ht
        · exact KNode.retarget_times n ti q.1 m1 t ht
      · intro c' z
        rcases h1n with he | ⟨ti, he⟩ <;> rw [he]
        constructor
        · intro hm
          rcases KNode.retarget_liveAt n ti q.1 m1 t c' z hm with h | ⟨_, h⟩
          · exact h
          · exact absurd h (hno q List.mem_cons_self c')
        · intro hm
          exact KNode.retarget_liveAt_of n ti q.1 m1 t c' z hm (fun h => by
            rw [h] at hm; exact hno q List.mem_cons_self c' hm)
    · have hq2' : q.2 = false := by simpa using hq2
      simp only [writerWP_bind, hq2', Bool.false_eq_true, ↓reduceIte]
      refine writerWP_mono (writerWP_unlink_frameV q.1 c w) ?_
      intro _ w1 ⟨h1t, h1top, h1next, h1v, h1l⟩
      refine (writerWP_pure _ c _ _).mpr ?_
      dsimp only
      apply hrest _ n h1top h1next h1v
      · intro y _; rw [h1t]
      · intro y _ hy; exact h1l y hy
      · rw [h1l p (Ne.symm hqp)]; exact hlk
      · rfl
      · exact fun h => h
      · exact fun _ _ => Iff.rfl

/-- The values after a step that kept them and took back no node but in S, whose
nodes were not taken and had no value: as before. -/
theorem wValue_eq_of_taken (base : View BVal) (w w' : W) (hv : w'.vals = w.vals)
    (S : NodeId → Prop) (ht : ∀ y, ¬ S y → w'.taken.contains y = w.taken.contains y)
    (hS : ∀ y, S y → w.taken.contains y = false ∧ wValue base w y = none) :
    wValue base w' = wValue base w := by
  funext y
  by_cases hy : S y
  · obtain ⟨htf, hvn⟩ := hS y hy
    rw [hvn]
    unfold wValue at hvn ⊢
    simp only [htf, Bool.false_eq_true, ↓reduceIte] at hvn
    cases h : w'.taken.contains y with
    | true => rfl
    | false =>
      simp only [Bool.false_eq_true, ↓reduceIte]
      rw [hv]; exact hvn
  · unfold wValue
    rw [ht y hy, hv]

/-- The merge's tail keeps the reading of every key, the merged nodes made by the
transaction or not: two siblings l and r under a reached inner parent p with
room; the siblings' compare values in their ranges; the merged nodes have no
value. -/
theorem writerWP_mergeTail_made_get (c : Ctx) (base : View BVal) (x : NodeId) (d : Nat) (p : NodeId)
    (pn xn : KNode) (leftSome : Bool) (l : NodeId) (ln : KNode) (il : Nat) (r : NodeId)
    (rn : KNode) (ir : Nat) (cL cR : Nat) (N : NodeId → Option KNode) (root : NodeId) (nx : Nat)
    (w3 : W) (hT : TreeOK N c.i root) (hp : TReach N c.i root p) (hpn : N p = some pn)
    (hL : pn.ks[il]? = some (.key cL l)) (hLL : LastLive pn.ks pn.lastBitmap il cL)
    (hR : pn.ks[ir]? = some (.key cR r)) (hRL : LastLive pn.ks pn.lastBitmap ir cR)
    (hc : cL ≠ cR) (hxlr : x = l ∨ x = r) (hln : N l = some ln) (hrn : N r = some rn)
    (hroom : pn.size + 4 ≤ c.p.M)
    (hdead : ∀ il cL m1 ir cR m2, deadOver c.p (mergeParentNode pn c.i il cL m1 ir cR m2) = false)
    (hpwf : klongsWf pn.ks = true) (hpt : ∀ s, Klong.time s ∈ pn.ks → s ≤ c.i)
    (hch : ∀ cc z zn, (cc, z) ∈ pn.liveAt c.i → N z = some zn →
      ∀ s, Klong.time s ∈ zn.ks → s ≤ c.i)
    (hN3 : wNode c.p base w3 = N) (h3top : w3.top.rootKey = root) (h3next : w3.next = nx)
    (h3p : w3.nodes.lookup p = some pn) (h3src : ∀ z, (w3.nodes.lookup z).isSome = true → z < nx)
    (hfree : ∀ z, nx ≤ z → N z = none ∧ w3.taken.contains z = false)
    (hfreshT : ∀ z, nx ≤ z → ∀ u c', TReach N c.i root u → ¬ TLink N c.i u c' z)
    (hpleaf : pn.leaf = false) (hclt : cL < cR) (hcap : 1 ≤ c.p.mergeMax)
    (hadj : ∀ cc z, (cc, z) ∈ pn.liveAt c.i → cc ≤ cL ∨ cR ≤ cc)
    (hll : ln.leaf = xn.leaf) (hrl : rn.leaf = xn.leaf)
    (hlrange : ∀ cc z, (cc, z) ∈ ln.liveAt c.i → cc < cR)
    (hllow : ∀ cc z, (cc, z) ∈ ln.liveAt c.i →
      ((!xn.leaf) = true → cc = 0 ∨ cL < cc) ∧ ((!xn.leaf) = false → cL ≤ cc))
    (hrrange : ∀ cc z, (cc, z) ∈ rn.liveAt c.i →
      ((!xn.leaf) = true → cc = 0 ∨ cR < cc) ∧ ((!xn.leaf) = false → cR ≤ cc))
    (hrup : ∀ k z, (k, z) ∈ pn.liveAt c.i → cR < k → ∀ cc z', (cc, z') ∈ rn.liveAt c.i → cc < k)
    (htimesN : ∀ y yn, N y = some yn → ∀ s, Klong.time s ∈ yn.ks → s ≤ c.i)
    (hwfN : ∀ y yn, N y = some yn → klongsWf yn.ks = true)
    (hnoval : ∀ y yn, N y = some yn → wValue base w3 y = none) :
    WriterWP (mergeTail c x d p pn xn leftSome l ln il r rn ir) c w3
      (fun _ w' => ∀ key, wGet c.p c.i base w' key = wGet c.p c.i base w3 key) := by
  -- the tree's facts
  have hpL : (cL, l) ∈ pn.liveAt c.i := by
    rw [KNode.liveAt_of_times pn c.i hpt]
    apply mem_of_lookup_nodup
    rw [KNode.live_lookup]
    exact keyLookup_of_last _ _ _ il l hL hLL
  have hpR : (cR, r) ∈ pn.liveAt c.i := by
    rw [KNode.liveAt_of_times pn c.i hpt]
    apply mem_of_lookup_nodup
    rw [KNode.live_lookup]
    exact keyLookup_of_last _ _ _ ir r hR hRL
  have hlink_l : TLink N c.i p cL l := ⟨pn, hpn, hpL⟩
  have hlink_r : TLink N c.i p cR r := ⟨pn, hpn, hpR⟩
  have hlR : TReach N c.i root l := TReach.link hp hlink_l
  have hrR : TReach N c.i root r := TReach.link hp hlink_r
  have hpl : p ≠ l := fun h => hT.no_self_link p cL hp (by rw [← h] at hlink_l; exact hlink_l)
  have hpr : p ≠ r := fun h => hT.no_self_link p cR hp (by rw [← h] at hlink_r; exact hlink_r)
  have hpx : p ≠ x := by rcases hxlr with h | h <;> rw [h] <;> assumption
  have hlt := hch cL l ln hpL hln
  have hrt := hch cR r rn hpR hrn
  have hcvL : pn.cv? il = some cL := by simp [KNode.cv?, hL]
  have hcvR : pn.cv? ir = some cR := by simp [KNode.cv?, hR]
  have hlt_nx : ∀ y yn, N y = some yn → y < nx := by
    intro y yn hy
    rcases Nat.lt_or_ge y nx with h | h
    · exact h
    · have := (hfree y h).1; rw [this] at hy; cases hy
  have hlnx := hlt_nx l ln hln
  have hrnx := hlt_nx r rn hrn
  have hpnx := hlt_nx p pn hpn
  unfold mergeTail
  simp only [hcvL, hcvR]
  generalize hLM : (ln.firstTime == some c.i) = lMade
  generalize hRM : (rn.firstTime == some c.i) = rMade
  simp only [note, writerWP_bind, writerWP_modify, writerWP_pure]
  generalize hmk : mergeKlongs (!xn.leaf) c.p.mergeMax cR ln.live rn.live = fs
  obtain ⟨first, second⟩ := fs
  wpSplit
  · simp only [writerWP_bind]; exact writerWP_throw _ _ _ _
  wpSplit
  · simp only [writerWP_bind]; exact writerWP_throw _ _ _ _
  rename_i hne1 hne2
  have hrhead : (!xn.leaf) = true → ∃ y0 tl, rn.live = (0, y0) :: tl := by
    intro hin
    rw [hin] at hne2
    simp only [Bool.true_and, Bool.or_eq_true, bne_iff_ne, ne_eq, not_or, Decidable.not_not]
      at hne2
    cases hr' : rn.live with
    | nil => rw [hr'] at hne2; simp at hne2
    | cons a tl =>
      rw [hr'] at hne2
      simp only [List.head?_cons, Option.map_some, Option.some.injEq] at hne2
      exact ⟨a.2, tl, by rw [← hne2.2]⟩
  have hsortE := mrg_mergeList_sorted ln rn c.i (!xn.leaf) cR hlt hrt hlrange hrrange hrhead
  have hndE : ((mergeList (!xn.leaf) cR ln.live rn.live).map Prod.fst).Nodup :=
    List.pairwise_map.mpr (hsortE.imp (by intro a b hab; omega))
  have hll' : ln.leaf = !(!xn.leaf) := by rw [hll]; simp
  have hrl' : rn.leaf = !(!xn.leaf) := by rw [hrl]; simp
  have hm1notR : ¬ TReach N c.i root nx := not_reach_fresh N c.i root nx hT (hfree nx (Nat.le_refl _)).1
    (hfreshT nx (Nat.le_refl _))
  obtain ⟨hparOne, hparTwo⟩ := mrg_parent_liveAt pn c.i il cL nx ir cR l r hpwf hpt hL hLL hR hRL hc
  -- the merged nodes: not taken, no value
  have hlrS : ∀ y, (y = l ∨ y = r) → w3.taken.contains y = false ∧ wValue base w3 y = none := by
    intro y hy
    obtain ⟨yn, hyn⟩ : ∃ yn, N y = some yn := by
      rcases hy with hy | hy <;> rw [hy]
      · exact ⟨ln, hln⟩
      · exact ⟨rn, hrn⟩
    refine ⟨?_, hnoval y yn hyn⟩
    have := hN3 ▸ hyn
    unfold wNode at this
    split at this
    · cases this
    · rename_i h; simpa using h
  simp only [writerWP_bind, writerWP_modify]
  refine writerWP_mono (writerWP_ghOf_frame x c _) ?_
  intro gh w4 ⟨h4t, h4top, h4n, h4v, h4p, h4m, h4l⟩
  have hcl' : ∀ (b1 b2 : Bool) y, y ≠ l → y ≠ r → ∀ q ∈ [(l, b1), (r, b2)], y ≠ (q : NodeId × Bool).1 := by
    intro b1 b2 y hyl hyr q hq
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hq
    rcases hq with h | h <;> rw [h] <;> assumption
  have hne' : ∀ (b1 b2 : Bool), ∀ q ∈ [(l, b1), (r, b2)], (q : NodeId × Bool).1 ≠ p := by
    intro b1 b2 q hq
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hq
    rcases hq with h | h <;> rw [h]
    · exact Ne.symm hpl
    · exact Ne.symm hpr
  cases lMade <;> cases rMade <;>
    simp only [Bool.false_eq_true, ↓reduceIte, writerWP_bind, writerWP_modify, writerWP_pure,
      replacedBy, writerWP_get]
  all_goals
    refine writerWP_mono (writerWP_newKey_frame _ _ _ _ c _) ?_
    intro m1 w5 ⟨hm1, h5n, h5t, h5top, h5next, h5v, h5p, h5m⟩
    refine writerWP_mono (writerWP_setMadeFor_frame _ _ c _) ?_
    intro _ w6 ⟨h6n, h6t, h6top, h6next, h6v, h6p⟩
    -- the ids
    have hm1 : m1 = nx := by rw [hm1, h4n, h3next]
    subst hm1
    have hxnx : x < m1 := by rcases hxlr with h | h <;> rw [h] <;> assumption
    have hlk4 : ∀ y, y ≠ x → w4.nodes.lookup y = w3.nodes.lookup y := h4l
    have hnone3 : ∀ z, m1 ≤ z → w3.nodes.lookup z = none := by
      intro z hz
      cases h' : w3.nodes.lookup z with
      | none => rfl
      | some _ => have := h3src z (by rw [h']; rfl); omega
    have hw6p : w6.nodes.lookup p = some pn := by
      rw [h6n, h5n, lookup_append_single_ne _ _ _ _ (by omega), hlk4 p hpx, h3p]
    have hw6m1 : w6.nodes.lookup w4.next = some ⟨!!xn.leaf, newKlongs c.i first⟩ := by
      rw [h6n, h5n, lookup_append_single_self]
      rw [hlk4 _ (by rw [h4n, h3next]; omega), h4n, h3next]
      exact hnone3 m1 (Nat.le_refl _)
    have h6taken : w6.taken = w3.taken := by rw [h6t, h5t, h4t]
    have h6old : ∀ y, y ≠ x → y ≠ m1 → w6.nodes.lookup y = w3.nodes.lookup y := by
      intro y hyx hym
      rw [h6n, h5n, lookup_append_single_ne _ _ _ _ (by rw [h4n, h3next]; exact hym), hlk4 y hyx]
    have hpT : w3.taken.contains p = false := by
      have := hN3 ▸ hpn
      unfold wNode at this
      split at this
      · cases this
      · rename_i h; simpa using h
    have hm1T : w3.taken.contains m1 = false := (hfree m1 (Nat.le_refl _)).2
    have hm1N : N m1 = none := (hfree m1 (Nat.le_refl _)).1
    have hNw3 : ∀ y, wNode c.p base w3 y = N y := fun y => by rw [hN3]
    have hhtd := htd_last pn
    -- the parent after
    have hpliveAt : ∀ (m2 : Option (NodeId × Nat)),
        ∀ cc z, (cc, z) ∈ (mergeParentNode pn c.i il cL m1 ir cR m2).liveAt c.i →
        (mergeParentNode pn c.i il cL m1 ir cR m2).live.lookup cc = some z := by
      intro m2 cc z hm
      rw [KNode.liveAt_of_times _ c.i (by
        rw [mergeParentNode_eq]
        exact mpNode_times pn c.i il cL m1 ir cR m2 _ _ _ (hhtd _) hpt)] at hm
      exact lookup_of_mem_nodup _ (KNode.live_keys_nodup _) cc z hm
    have hlm1 : l ≠ m1 := by omega
    have hrm1 : r ≠ m1 := by omega
    have hpm1 : p ≠ m1 := by omega
    have hw4m1 : w4.next = m1 := by rw [h4n, h3next]
    rw [hw4m1] at hw6m1
    have hmkd : splitMerged (!xn.leaf) c.p.mergeMax (mergeList (!xn.leaf) cR ln.live rn.live) =
        (first, second) := hmk
    have h6top' : w6.top.rootKey = root := by rw [h6top, h5top, h4top, h3top]
    have hyx : ∀ y, y ≠ l → y ≠ r → y ≠ x := by
      intro y hyl hyr; rcases hxlr with h | h <;> rw [h] <;> assumption
    have hlr' : ∀ (b1 b2 : Bool) (q : NodeId × Bool), q ∈ [(l, b1), (r, b2)] → q.1 = l ∨ q.1 = r := by
      intro b1 b2 q hq
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hq
      rcases hq with h | h <;> rw [h]
      · exact Or.inl rfl
      · exact Or.inr rfl
    -- the parent after, into one node
    have hchar1 : ∀ cc z, (cc, z) ∈ (mergeParentNode pn c.i il cL m1 ir cR none).liveAt c.i →
