<?xml version="1.0" encoding="UTF-8" ?>

<!--
ANT build script for building kissdb.jar, other jars and javadoc.
CHANGEIT Change properties "base" and "javac" to match your environment.
-->

<project name="KissDB" default="help" basedir=".">

<target name="help">
    <echo>Type "ant -p" to get a list of targets.</echo>
</target>

	
<target name="init" description="Initializes properties and prints version, release, and build.">
    <property name="version" value="2013.1"/>
    <property name="versionInt" value="131"/>

    <tstamp>
        <format property="dateString" pattern="yyMMdd" />
    </tstamp>

    <tstamp>
        <format property="minuteString" pattern="yyMMdd.HHmm" />
    </tstamp>

    <property name="base" value="/f/files/kissdb"/>                           <!-- CHANGEIT for your environment. -->
	<property name="javac" value="/f/kissdb-storage/jdk1.5.0_22/bin/javac"/>  <!-- CHANGEIT for your environment. -->
    <property name="release" value="${version}.${dateString}"/>
    <property name="build" value="${version}.${minuteString}"/>

    <!-- kissdb.core.BuildInfo.java is machine generated from template. -->
	<copy file="in/BuildInfoTemplate.txt" 
            toFile="src/kissdb/core/BuildInfo.java"
            overwrite="true">
	    <filterset begintoken="{{" endtoken="}}">
	        <filter token="version" value="${version}"/>
	        <filter token="versionInt" value="${versionInt}"/>
	        <filter token="release" value="${release}"/>
	        <filter token="build" value="${build}"/>
	    </filterset>
	</copy>

    <echo>version: ${version}</echo>
    <echo>versionInt: ${versionInt}, release: ${release}, build: ${build}</echo>
</target>
	
	
<target name="clean" description="Deletes files in out/.">
	<mkdir dir="out"/>
	<delete includeemptydirs="true">
	    <fileset dir="out" includes="**/*"/>
	</delete>
</target>

	
<!-- Compiles sources with Java 1.5 compiler. -->
<target name="compile" depends="init" description="Compiles Java sources to class files.">
	<mkdir dir="out/classes"/>
	
	<!-- Compiling with ${javac} compiler.
	     Note that fork="true" must be set, otherwise the "executable" parameter is ignored.
	-->
	
	<javac srcdir="src" destdir="out/classes" source="1.5" target="1.5" includeantruntime="false"
	       fork="true" executable="${javac}"/>
	
	<javac srcdir="src-icu" destdir="out/classes" source="1.5" target="1.5" includeantruntime="false"
	       fork="true" executable="${javac}"
		   classpath="out/classes:in/icu-for-kissdb.jar"/>
	
</target>

	
<target name="jar" depends="init, compile" description="Creates out/kissdb.jar and other jar files.">
	<mkdir dir="out/classes"/>
	
	<!-- kissdb.jar -->
		
	<delete file="out/MANIFEST.MF" failonerror="false"/>
	<delete file="out/kissdb.jar" failonerror="false"/>
	<delete file="src/kissdb/db/BuildInfo.java" failonerror="false"/>
	
    <manifest file="out/MANIFEST.MF">
        <attribute name="Main-Class" value="kissdb.dev.Run"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>    <!-- how to remove completely? -->
        <attribute name="Created-By" value=""/>     <!-- only managed to overwrite -->
        <attribute name="version" value="${version}"/>
        <attribute name="release" value="${release}"/>
        <attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/kissdb.jar" manifest="out/MANIFEST.MF">
        <fileset dir="out/classes">
            <include name="kissdb/**/*.class"/>   <!-- Only classfiles, no resources. -->
        </fileset>
        <zipfileset src="in/icu-for-kissdb.jar"/>
    </jar>
	
	<!-- Copies kissdb.jar to version directory. -->
    <copy tofile="${base}/${version}/kissdb.jar" 
            file="out/kissdb.jar" overwrite="true"/>
	<copy todir="${base}/${version}/more/dev/dotnet/" 
	        file="out/kissdb.jar" overwrite="true"/>

    <!-- kissdb-no-icu.jar (used by dev/kissdb-for-c (gcc)) -->

    <delete file="out/kissdb-no-icu.jar" failonerror="false"/>
	
    <jar jarfile="out/kissdb-no-icu.jar"
            manifest="out/MANIFEST.MF">
        <fileset dir="out/classes">
            <include name="kissdb/**/*.class"/>     <!-- Only classfiles. -->
            <exclude name="kissdb/pubimpicu/**"/>   <!-- must be omitted -->
        </fileset>
    </jar>
    
    <!-- kissdb-core.jar - Core Layer build -->

    <delete file="out/kissdb-core.jar" failonerror="false"/>
    <delete file="out/MANIFEST-core.MF" failonerror="false"/>

    <manifest file="out/MANIFEST-core.MF">
        <attribute name="Main-Class" value="kissdb.coredev.Run"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>
        <attribute name="Created-By" value=""/>
        <attribute name="version" value="${version}"/>
        <attribute name="release" value="${release}"/>
        <attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/kissdb-core.jar" manifest="out/MANIFEST-core.MF">
        <fileset dir="out/classes">    
        	<include name="kissdb/nanotest/**"/>
        	<include name="kissdb/common/**"/>
        	<include name="kissdb/stream/**"/>
        	<include name="kissdb/storage/**"/>
        	<include name="kissdb/core/**"/>
        	<include name="kissdb/coredev/**"/>

            <!-- Part of pub shared with Core/Storage layers, the "pubs group". -->
            <include name="kissdb/pub/Clock.class"/>
            <include name="kissdb/pub/DbException.class"/>
            <include name="kissdb/pub/LookupTimeNotAvailableException.class"/>
            <include name="kissdb/pub/BadReplicaException.class"/>
        	<include name="kissdb/pub/IllegalDbStateException.class"/>
            <include name="kissdb/pub/Storage*.class"/>
            <include name="kissdb/pub/Job.class"/>
            <include name="kissdb/pub/JobStatus.class"/>

            <!-- coredev, nanotest could be omitted, but does not reduce jar size much. 
                Worth keeping them to have self-tests included. -->
        </fileset>
    </jar>

    <!-- jar for instrumentation, used by kissdb.dev.ObjectSize. inst.jar 
         Only used for developement purpose only. -->
    
    <delete file="out/inst-MANIFEST.MF" failonerror="false"/>
    <delete file="out/bin/inst.jar" failonerror="false"/>

    <manifest file="out/MANIFEST-inst.MF">
        <attribute name="Premain-Class" value="kissdb.dev.KissInstrumentation"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>
        <attribute name="Created-By" value=""/>
    	<attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/inst.jar"
            manifest="out/MANIFEST-inst.MF">
        <fileset dir="out/classes">
            <include name="kissdb/dev/KissInstrumentation.class"/>
        </fileset>
    </jar>
</target>

	
<target name="javadoc" depends="init, compile" description="Creates javadoc.">
    <property name="javadoc-dir" value="${base}/${version}/doc"/>
    <property name="javadoc-all-dir" value="${base}/${version}/more/doc-all"/>
	
    <mkdir dir="${base}/${version}"/>   <!-- Creates directory in case it would not exist. -->
    <delete dir="${javadoc-dir}" failonerror="false"/>
    <delete dir="${javadoc-all-dir}" failonerror="false"/>

    <javadoc destdir="${javadoc-dir}"
    	    overview="src/overview-pub.html"
            doctitle="KissDB ${version} Pub API"
            windowtitle="KissDB ${version} Pub API"
            Footer="KissDB release: ${release}. Copyright Frans Lundberg."
            encoding="utf-8">
        <packageset dir="src" defaultexcludes="yes">
            <include name="kissdb/pub/**"/>
        </packageset>

        <classpath>
            <fileset dir="">
                <include name="in/icu-for-kissdb.jar"/>
            </fileset>
        </classpath>
    </javadoc>

    <javadoc destdir="${javadoc-all-dir}"
    	    overview="src/overview-all.html"
            doctitle="KissDB ${version} javadoc-all"
            windowtitle="KissDB ${version} javadoc-all"
            Footer="KissDB release: ${release}. Copyright Frans Lundberg."
            encoding="utf-8"
    	    linksource="no">   <!-- 1306 Frans: chose "no" for now. -->
        <packageset dir="src" defaultexcludes="yes">
        </packageset>

        <classpath>
            <fileset dir="">
                <include name="in/icu-for-kissdb.jar"/>
            </fileset>
        </classpath>
    </javadoc>
</target>

</project>
