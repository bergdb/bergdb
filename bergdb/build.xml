<?xml version="1.0" encoding="UTF-8" ?>

<!--
ANT build script for building bergdb.jar, other jars and javadoc.
CHANGEIT Change properties "base" and "javac" to match your environment.
-->

<project name="bergdb" default="help" basedir=".">

<target name="help">
    <echo>Type "ant -p" to get a list of targets.</echo>
</target>

	
<target name="init" description="Initializes properties and prints version, release, and build.">
    <property name="release" value="2014.2"/>                     <!-- CHANGEIT for new release. -->
    <property name="releaseInt" value="142"/>                     <!-- CHANGEIT for new release. -->

    <tstamp>
        <format property="dateString" pattern="yyMMdd" />
    </tstamp>

    <tstamp>
        <format property="minuteString" pattern="yyMMdd.HHmm" />
    </tstamp>

    <property name="base" value="/home/f/fl/bergdb"/>             <!-- CHANGEIT for your environment. -->
    <property name="javac" value="/a/pr/jdk1.5.0_22/bin/javac"/>  <!-- CHANGEIT for your environment. -->
    <property name="build" value="${release}.${minuteString}"/>

    <!-- bergdb.core.BuildInfo.java is generated from a template. -->
	<copy file="in/BuildInfoTemplate.txt" 
            toFile="src/bergdb/core/BuildInfo.java"
            overwrite="true">
	    <filterset begintoken="{{" endtoken="}}">
	        <filter token="releaseInt" value="${releaseInt}"/>
	        <filter token="release" value="${release}"/>
	        <filter token="build" value="${build}"/>
	    </filterset>
	</copy>

    <echo>release: ${release}, releaseInt: ${releaseInt}, build: ${build}</echo>
</target>
	
	
<target name="clean" description="Deletes files in out/.">
	<mkdir dir="out"/>
	<delete includeemptydirs="true">
	    <fileset dir="out" includes="**/*"/>
	</delete>
</target>

	
<!-- 
  Compiles sources with ${javac} compiler. 
  Note that fork="true" must be set, otherwise the "executable" parameter is ignored. 
-->
<target name="compile" depends="init" description="Compiles Java sources to class files.">
	<mkdir dir="out/classes"/>

	<javac srcdir="src" destdir="out/classes" source="1.5" target="1.5" includeantruntime="false"
	       fork="true" executable="${javac}"/>

	<javac srcdir="src-dev" destdir="out/classes" source="1.5" target="1.5" includeantruntime="false"
	       fork="true" executable="${javac}"/>

	<javac srcdir="src-icu" destdir="out/classes" source="1.5" target="1.5" includeantruntime="false"
	       fork="true" executable="${javac}"
		   classpath="out/classes:in/icu-for-bergdb.jar"/>
	
</target>

	
<target name="jar" depends="init, compile" description="Creates out/bergdb.jar and other jar files.">
	<mkdir dir="out/classes"/>
	
	<!-- bergdb.jar -->
		
	<delete file="out/MANIFEST.MF" failonerror="false"/>
	<delete file="out/bergdb.jar" failonerror="false"/>
	<delete file="src/bergdb/db/BuildInfo.java" failonerror="false"/>
	
    <manifest file="out/MANIFEST.MF">
        <attribute name="Main-Class" value="bergdb.dev.Run"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>    
        <attribute name="Created-By" value=""/>     
        <attribute name="release" value="${release}"/>
        <attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/bergdb.jar" manifest="out/MANIFEST.MF">
        <fileset dir="out/classes">
            <include name="bergdb/**/*.class"/>   <!-- Only classfiles, no resources. -->
        </fileset>
        <zipfileset src="in/icu-for-bergdb.jar"/>
    </jar>
	
    <copy tofile="${base}/${release}/bergdb.jar" 
            file="out/bergdb.jar" overwrite="true"/>
	<copy todir="${base}/${release}/more/dev/dotnet/" 
	        file="out/bergdb.jar" overwrite="true"/>

    <!-- bergdb-no-icu.jar (used by dev/kissdb-for-c (gcc)) -->

    <delete file="out/bergdb-no-icu.jar" failonerror="false"/>
	
    <jar jarfile="out/bergdb-no-icu.jar"
            manifest="out/MANIFEST.MF">
        <fileset dir="out/classes">
            <include name="bergdb/**/*.class"/>     <!-- Only classfiles. -->
            <exclude name="bergdb/pubimpicu/**"/>   <!-- Must be omitted. -->
        </fileset>
    </jar>
	
	<copy todir="${base}/${release}/more/" file="out/bergdb-no-icu.jar" overwrite="true"/>
    
    <!-- bergdb-core.jar - Core Layer build -->

    <delete file="out/bergdb-core.jar" failonerror="false"/>
    <delete file="out/MANIFEST-core.MF" failonerror="false"/>

    <manifest file="out/MANIFEST-core.MF">
        <attribute name="Main-Class" value="bergdb.coredev.Run"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>
        <attribute name="Created-By" value=""/>
        <attribute name="release" value="${release}"/>
        <attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/bergdb-core.jar" manifest="out/MANIFEST-core.MF">
        <fileset dir="out/classes">    
        	<include name="bergdb/nanotest/**"/>
        	<include name="bergdb/common/**"/>
        	<include name="bergdb/stream/**"/>
        	<include name="bergdb/storage/**"/>
        	<include name="bergdb/dag/**"/>
        	<include name="bergdb/core/**"/>
        	<include name="bergdb/coredev/**"/>

            <!-- Part of pub shared with Core/Storage layers, the "pubs group". -->
            <include name="bergdb/pub/Clock.class"/>
            <include name="bergdb/pub/DbException.class"/>
            <include name="bergdb/pub/LookupTimeNotAvailableException.class"/>
            <include name="bergdb/pub/BadReplicaException.class"/>
        	<include name="bergdb/pub/IllegalDbStateException.class"/>
        	<include name="bergdb/pub/BadFormatException.class"/>
            <include name="bergdb/pub/Storage*.class"/>
            <include name="bergdb/pub/Job.class"/>
            <include name="bergdb/pub/JobStatus.class"/>

            <!-- coredev, nanotest could be omitted, but does not reduce jar size much. 
                 Worth keeping them to have self-tests included. -->
        </fileset>
    </jar>
	
	<copy todir="${base}/${release}/more/" file="out/bergdb-core.jar" overwrite="true"/>
</target>

<!-- 
inst.jar, jar for instrumentation, used by bergdb.dev.ObjectSize. 
Only used for developement purpose only. 
-->
<target name="inst.jar" depends="init, compile" description="Creates out/inst.jar.">
    <mkdir dir="out/classes"/>    
    <delete file="out/inst-MANIFEST.MF" failonerror="false"/>
    <delete file="out/inst.jar" failonerror="false"/>

    <manifest file="out/MANIFEST-inst.MF">
        <attribute name="Premain-Class" value="bergdb.dev.MyInstrumentation"/>
        <attribute name="Copyright" value="Frans Lundberg"/>
        <attribute name="Author" value="Frans Lundberg"/>
        <attribute name="Ant-Version" value=""/>
        <attribute name="Created-By" value=""/>
        <attribute name="build" value="${build}"/>
    </manifest>

    <jar jarfile="out/inst.jar" manifest="out/MANIFEST-inst.MF">
        <fileset dir="out/classes">
            <include name="bergdb/dev/MyInstrumentation.class"/>
        </fileset>
    </jar>
</target>

	
<target name="javadoc" depends="init, compile" description="Creates javadoc.">
    <property name="javadoc-dir" value="${base}/${release}/javadoc"/>
    <property name="javadoc-all-dir" value="${base}/${release}/more/javadoc-all"/>

    <mkdir dir="${base}/${release}"/>   <!-- Creates directory in case it would not exist. -->
    <delete dir="${javadoc-dir}" failonerror="false"/>
    <delete dir="${javadoc-all-dir}" failonerror="false"/>

    <javadoc destdir="${javadoc-dir}"
    	    overview="src/overview-pub.html"
            doctitle="BergDB ${release} Pub API"
            windowtitle="BergDB ${release} Pub API"
            footer="&lt;a href=&quot;http://bergdb.com/&quot;>BergDB&lt;a> release: ${release}. Copyright Frans Lundberg."
            encoding="utf-8"
    	    stylesheetfile="in/style.css">
    	
        <packageset dir="src" defaultexcludes="yes">
            <include name="bergdb/pub/**"/>
        </packageset>

        <classpath>
            <fileset dir="">
                <include name="in/icu-for-kissdb.jar"/>
            </fileset>
        </classpath>
    </javadoc>
	
    <javadoc destdir="${javadoc-all-dir}"
    	    overview="src/overview-all.html"
            doctitle="BergDB ${release} javadoc-all"
            windowtitle="BergDB ${release} javadoc-all"
            footer="&lt;a href=&quot;http://bergdb.com/&quot;>BergDB&lt;a> release: ${release}. Copyright Frans Lundberg."
            encoding="utf-8"
    	    linksource="no"
	        stylesheetfile="in/style.css">
    	
    	<packageset dir="src" defaultexcludes="yes">
    	    <include name="bergdb/**"/>
    	</packageset>

    	<packageset dir="src-dev" defaultexcludes="yes">
    	    <include name="bergdb/**"/>
    	</packageset>
    		
        <classpath>
            <fileset dir="">
                <include name="in/icu-for-bergdb.jar"/>
            </fileset>
        </classpath>
    </javadoc>
	
</target>

</project>
