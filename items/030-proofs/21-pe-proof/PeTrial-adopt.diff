+/-! ## 030-21 part 2: PE's record, A6', A-COPY and PE's provenance, computed -/
+
+namespace Adopt
+
+open SIS (Changes NewNode)
+open SIS.Check (BVal)
+
+/-- PeRecord.lean's `newTopOf`, `lvlOf`, `isDataOf`, `peChange`. -/
+def newTopOf (tp : Contract.Top) (o : Contract.PE.Out) : Option (NodeId × Contract.TopNode) :=
+  if o.top.length = tp.length then none else o.top.getLast?
+
+def lvlOf (T : Contract.Tree) (x : NodeId) : Nat :=
+  match T.obj x with
+  | some ob => Contract.lvl ob
+  | none => 0
+
+def isDataOf (T : Contract.Tree) (x : NodeId) : Bool :=
+  match T.obj x with
+  | some (.val _) => true
+  | _ => false
+
+def keyMax (cf : Contract.PE.Cfg) : Nat := 1 + cf.G * (cf.H + 1) + cf.H
+def topBase (cf : Contract.PE.Cfg) : Nat := keyMax cf + 1
+
+def peChange (cf : Contract.PE.Cfg) (s : Contract.Tree) (tp : Contract.Top) (o : Contract.PE.Out) : Changes BVal :=
+  let T := o.tree s
+  let xs := (o.ws.map (·.1)).reverse
+  { new := (xs.filter (fun x => (s.obj x).isNone)).map (fun x => ⟨x, lvlOf T x, isDataOf T x⟩) ++
+      (match newTopOf tp o with
+       | some (z, _) => [⟨z, topBase cf + tp.length, false⟩]
+       | none => []),
+    adds := xs.flatMap (fun x => (Contract.newVals s T x).map (fun v => (x, v))) ++
+      (match newTopOf tp o with
+       | some (z, n) => (0, BVal.top z) :: (Contract.topVals n).map (fun v => (z, v))
+       | none => []),
+    touch := [] }
+
+/-- PeAdopt.lean's `kidOf` and `provB` (the exact, slow definitions). -/
+def kidOf (s : Contract.Tree) (q y : NodeId) : Bool :=
+  match s.obj q with
+  | some (.key n) => (Contract.live n.ks).any (fun cy => cy.2 == y)
+  | _ => false
+
+def provB (s T : Contract.Tree) (D : List NodeId) : Bool :=
+  D.all (fun p => match T.obj p with
+    | some (.key m) => (Contract.live m.ks).all (fun cy => (s.obj cy.2).isNone || kidOf s p cy.2 ||
+        (Contract.reach s).any (fun q => !D.contains q && kidOf s q cy.2))
+    | _ => true)
+
+/-- `provB`, fast: the parent of a moved node by the map of the walk. -/
+def provFast (s T : Contract.Tree) (D : List NodeId) (par : Std.HashMap NodeId NodeId) : Bool :=
+  let Ds : Std.HashSet NodeId := Std.HashSet.ofList D
+  D.all (fun p => match T.obj p with
+    | some (.key m) => (Contract.live m.ks).all (fun cy => (s.obj cy.2).isNone || kidOf s p cy.2 ||
+        (match par[cy.2]? with
+         | some q => !Ds.contains q
+         | none => false))
+    | _ => true)
+
+/-- The old nodes that the nodes written name by a live klong after the
+transaction and that were no live child of them before (moved). -/
+def movedCount (s T : Contract.Tree) (D : List NodeId) : Nat :=
+  D.foldl (fun n p => match T.obj p with
+    | some (.key m) => n + ((Contract.live m.ks).filter (fun cy =>
+        (s.obj cy.2).isSome && !kidOf s p cy.2)).length
+    | _ => n) 0
+
+/-- The walk's parent map (a node by the last node reached naming it live). -/
+def parents (s : Contract.Tree) (rl : List NodeId) : Std.HashMap NodeId NodeId :=
+  rl.foldl (fun m q => match s.obj q with
+    | some (.key n) => (Contract.live n.ks).foldl (fun m cy => m.insert cy.2 q) m
+    | _ => m) {}
+
+/-- For each node, the nodes reached that name it by a key klong, Contract.live or dead. -/
+def namers (s : Contract.Tree) (rl : List NodeId) : Std.HashMap NodeId (List NodeId) :=
+  rl.foldl (fun m z => match s.obj z with
+    | some (.key n) => n.ks.foldl (fun m k => match k with
+        | .key _ y => m.insert y (z :: (m.getD y []))
+        | _ => m) m
+    | _ => m) {}
 
+/-- `copyOk`, fast. -/
+def copyFast (s : Contract.Tree) (tp : Contract.Top) (c : Changes BVal) (before now : Std.HashSet NodeId)
+    (nm : Std.HashMap NodeId (List NodeId)) : Bool :=
+  let addIds : Std.HashSet NodeId := Std.HashSet.ofList (c.adds.map (·.1))
+  let newIds : Std.HashSet NodeId := Std.HashSet.ofList (c.new.map (·.id))
+  let path := fun x => before.contains x && (addIds.contains x || c.touch.contains x || !now.contains x)
+  let topMade := c.adds.any (fun a => match a.2 with
+    | .top _ => true
+    | _ => false)
+  let named := fun y => newIds.contains y || path y || (nm.getD y []).any path ||
+    (topMade && match tp.getLast? with
+      | some (_, nw) => nw.root == y
+      | none => false)
+  let _ := s
+  c.adds.all (fun a => match a.2 with
+    | .key _ y => named y
+    | .rootKey y => named y
+    | .skip _ y =>
+      match tp.getLast? with
+      | some (w, nw) => y == w || nw.skips.any (fun q => q.2.1 == y)
+      | none => false
+    | _ => true)
+
+/-- `adoptOk`, fast; and the number of klongs that needed its fourth case
+("below x"), which `InvA` says PE never needs. -/
+def adoptFast (sT : Contract.Tree) (rl : List NodeId) (now : Std.HashSet NodeId) : Bool × Nat := Id.run do
+  let mut ok := true
+  let mut below := 0
+  for x in rl do
+    match sT.obj x with
+    | some (.key n) =>
+      let lv : Std.HashSet NodeId := Std.HashSet.ofList ((Contract.live n.ks).map (·.2))
+      for k in n.ks do
+        match k with
+        | .key _ y =>
+          let isVal := match sT.obj y with
+            | some (.val _) => true
+            | _ => false
+          if !(lv.contains y || isVal || !now.contains y) then
+            below := below + 1
+            if !(Contract.reachAt sT (sT.fuel x) x).contains y then ok := false
+        | _ => pure ()
+    | _ => pure ()
+  return (ok, below)
+
+end Adopt
+
