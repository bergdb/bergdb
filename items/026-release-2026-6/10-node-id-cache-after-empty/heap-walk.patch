+class DebugWalk {   // DEBUG idpos (temporary)
+    static void walk(Object root, String label) {
+        java.util.IdentityHashMap<Object, Boolean> seen = new java.util.IdentityHashMap<>();
+        java.util.ArrayDeque<Object[]> q = new java.util.ArrayDeque<>();
+        java.util.Map<String, long[]> by = new java.util.TreeMap<>();
+        q.add(new Object[] {root, "Db"});
+        seen.put(root, true);
+        while (!q.isEmpty()) {
+            Object[] e = q.poll();
+            Object o = e[0];
+            String ref = (String) e[1];
+            Class<?> c = o.getClass();
+            if (o instanceof Class || o instanceof Thread || o instanceof ClassLoader) continue;
+            if (c.isArray()) {
+                if (o instanceof long[]) {
+                    long[] a = by.computeIfAbsent(ref, k -> new long[2]);
+                    a[0]++;
+                    a[1] += 16 + 8L * ((long[]) o).length;
+                } else if (!c.getComponentType().isPrimitive()) {
+                    for (Object x : (Object[]) o) {
+                        if (x != null && seen.put(x, true) == null) q.add(new Object[] {x, ref});
+                    }
+                }
+                continue;
+            }
+            for (Class<?> k = c; k != null; k = k.getSuperclass()) {
+                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
+                    if (java.lang.reflect.Modifier.isStatic(f.getModifiers()) || f.getType().isPrimitive()) continue;
+                    Object x;
+                    try { f.setAccessible(true); x = f.get(o); } catch (Exception ex) { continue; }
+                    if (x == null || seen.put(x, true) != null) continue;
+                    String r2 = k.getName().startsWith("bergdb") ? k.getSimpleName() + "." + f.getName() : ref;
+                    q.add(new Object[] {x, r2});
+                }
+            }
+        }
+        for (java.util.Map.Entry<String, long[]> en : by.entrySet()) {
+            if (en.getValue()[1] > 20000) CountGates.out("  DEBUGWALK " + label + " " + en.getKey() + " n=" + en.getValue()[0] + " bytes=" + en.getValue()[1]);
+        }
+    }
+}
