 public class BufferedStream implements AppendOnlyStream, Closeable {
+    /** R3: stopping through an interrupt must still release the underlying stream. */
+    @Nano
+    public static void testStopAndInterruptClosesUnderlying() throws Exception {
+        final java.util.concurrent.atomic.AtomicBoolean closed =
+                new java.util.concurrent.atomic.AtomicBoolean();
+        MemoryStream m = new MemoryStream() {
+            public void close() {
+                closed.set(true);
+                super.close();
+            }
+        };
+        BufferedStream b = new BufferedStream(m, 1024, 60000);
+        boolean wasClosed = false;
+        b.start();
+        try {
+            long end = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(1);
+            while (b.consumer.getState() != Thread.State.TIMED_WAITING
+                    && System.nanoTime() < end) Thread.sleep(1);
+            Assert.assertEquals(Thread.State.TIMED_WAITING, b.consumer.getState());
+            synchronized (b) {
+                b.consumer.interrupt();
+                // Let the interrupt remove it from the wait set before stop notifies.
+                // It still cannot enter the catch until we release b.
+                long interruptedEnd = System.nanoTime()
+                        + java.util.concurrent.TimeUnit.SECONDS.toNanos(1);
+                while (b.consumer.getState() != Thread.State.BLOCKED
+                        && System.nanoTime() < interruptedEnd) Thread.yield();
+                Assert.assertEquals(Thread.State.BLOCKED, b.consumer.getState());
+                b.stop();
+            }
+            b.consumer.join(1000);
+            Assert.assertFalse("the consumer ended", b.consumer.isAlive());
+            wasClosed = closed.get();
+        } finally {
+            b.close();
+        }
+        Assert.assertTrue("stop plus interrupt must close the underlying stream", wasClosed);
+    }
+
