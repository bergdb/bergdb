+    /**
+     * 016-06/S2-F14: a composite index whose second level has two fields, after a restart:
+     * a new object is indexed.
+     */
+    @Nano
+    public static void testS2TwoFieldsLevelAfterRestart() {
+        MemoryStream stream = new MemoryStream();
+        DatabaseBuilder builder = Factory.database();
+        ((DatabaseBuilderImp) builder).getDbBuilder().testSetup(stream);
+        Database db = builder.start();
+        try {
+            db.indexBuilder("ft").dir("/payments/").type("long").field("time")
+                    .type("string").field("from").field("to").createFast();
+        } finally {
+            db.close();
+        }
+        builder = Factory.database();
+        ((DatabaseBuilderImp) builder).getDbBuilder().testSetup(stream.copy());
+        db = builder.start();
+        try {
+            Connection c = db.newConnection();
+            c.put("/payments/1", new Payment2("a", "b", 7));
+            int count = 0;
+            for (Payment2 p : c.useIndex("ft", Payment2.class).eq(7).objects()) {
+                count++;
+            }
+            Assert.assertEquals(2, count);
+        } finally {
+            db.close();
+        }
+    }
+    
