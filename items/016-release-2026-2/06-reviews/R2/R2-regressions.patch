+            try {
+                f.append(new byte[1], 0, -1);
+                throw new AssertionError("negative append accepted");
+            } catch (IllegalArgumentException expected) {
+                // The rejection promised by AppendOnlyStream.append().
+            }
+            Assert.assertEquals(3, f.getLength());
+            byte[] tail = new byte[1];
+            f.read(2, tail, 0, 1);
+            Assert.assertEquals(3, tail[0]);
+            f.append(new byte[] {4}, 0, 1);
+        } finally {
+            f.close();
+        }
+    }
