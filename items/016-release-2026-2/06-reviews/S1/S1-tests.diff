+    /**
+     * S1-F6: CryptoKey overrides equals() and not hashCode(): two equal keys (one parsed
+     * from the other's serialize()) have different hash codes, against Object.hashCode()'s
+     * contract, so a HashSet or HashMap of keys does not find an equal key.
+     */
+    @Nano
+    public static void testCryptoKeyHashCode() {
+        CryptoKey k = CryptoKey.generate();
+        CryptoKey k2 = CryptoKey.parse(k.serialize());
+        Assert.assertTrue("equal", k.equals(k2));
+        java.util.Set<CryptoKey> set = new java.util.HashSet<CryptoKey>();
+        set.add(k);
+        Assert.assertTrue("a HashSet finds the equal key", set.contains(k2));
+    }
