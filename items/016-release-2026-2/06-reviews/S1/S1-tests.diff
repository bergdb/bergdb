+    /**
+     * S1-F5: DatabaseBuilder.cryptoKey(): "The crypto key to use or CryptoKey.NULL to not use
+     * any encryption." After a key, CryptoKey.NULL is ignored and the database is encrypted.
+     */
+    @Nano
+    public static void testCryptoKeyNullAfterKey() throws Exception {
+        MemoryStream m = new MemoryStream();
+        DatabaseBuilderImp b = (DatabaseBuilderImp) Factory.database();
+        b.mainStream(m);
+        b.cryptoKey(CryptoKey.generate()).cryptoKey(CryptoKey.NULL);
+        Database database = b.start();
+        database.connection().put("/a.txt", "v");
+        database.close();
+        byte[] magic = new byte[4];
+        m.read(0, magic, 0, 4);
+        Assert.assertEquals("the stream's first bytes, plain text without encryption", "berg",
+                new String(magic, "ISO-8859-1"));
+    }
