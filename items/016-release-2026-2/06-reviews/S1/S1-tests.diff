+    /** Probe: a byte[] put, then the caller's array changed; and a get's array changed. */
+    @Nano
+    public static void testByteArrayAliasing() {
+        Database db = Factory.database().memory().start();
+        try {
+            Connection c = db.connection();
+            final byte[] b = {1, 2, 3};
+            c.rw(new Action() {
+                public void run(RwEnvironment env) {
+                    env.put("/x.bin", b);
+                }
+            });
+            b[0] = 9;
+            int x = c.get("/x.bin", byte[].class)[0];
+            c.put("/y.bin", new byte[] {1, 2, 3});
+            c.get("/y.bin", byte[].class)[0] = 9;
+            int y = c.get("/y.bin", byte[].class)[0];
+            Assert.assertEquals("after the caller's change of its put's array, x[0]; after a "
+                    + "change of a get's array, y[0]", "1 1", x + " " + y);
+        } finally {
+            db.close();
+        }
+    }
+
+    /**
+     * S1-F8: the array of a byte[] put stays the database's value in memory, so the caller's
+     * later change changes what reads return; the stream holds the bytes of the commit, so
+     * a restart (or an eviction) returns the old value at the same time.
+     */
+    @Nano
+    public static void testByteArrayPutAliasedAgainstStream() {
+        MemoryStream m = new MemoryStream();
+        DatabaseBuilderImp b = (DatabaseBuilderImp) Factory.database();
+        b.mainStream(m);
+        Database db = b.start();
+        final byte[] value = {1, 2, 3};
+        int before;
+        try {
+            Connection c = db.connection();
+            c.rw(new Action() {
+                public void run(RwEnvironment env) {
+                    env.put("/x.bin", value);
+                }
+            });
+            c.sync();
+            value[0] = 9;
+            before = c.get("/x.bin", byte[].class)[0];
+        } finally {
+            db.close();
+        }
+        DatabaseBuilderImp b2 = (DatabaseBuilderImp) Factory.database();
+        b2.mainStream(m.copy());
+        Database db2 = b2.start();
+        int after;
+        try {
+            after = db2.connection().get("/x.bin", byte[].class)[0];
+        } finally {
+            db2.close();
+        }
+        Assert.assertEquals("the value's first byte before and after a restart", "1 1",
+                before + " " + after);
+    }
+
