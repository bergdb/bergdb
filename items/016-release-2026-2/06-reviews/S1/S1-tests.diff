+    /**
+     * S1-F1: many puts of one key in one rw-transaction; the last must win. MapKey.equals
+     * is never true, so each put is an entry of its own in one HashMap bin; once the bin is
+     * a tree, the iteration order is not the order of the puts.
+     */
+    @Nano
+    public static void testRwManyPutsOfOneKey() {
+        Database db = Factory.database().memory().start();
+        try {
+            Connection c = db.connection();
+            for (int round = 0; round < 20; round++) {
+                final int n = 40;
+                c.rw(new Action() {
+                    public void run(RwEnvironment env) {
+                        for (int i = 0; i < n; i++) {
+                            env.put("/c.txt", "v" + i);
+                        }
+                    }
+                });
+                Assert.assertEquals("round " + round, "v" + (n - 1), c.get("/c.txt", String.class));
+            }
+        } finally {
+            db.close();
+        }
+    }
