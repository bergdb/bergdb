+    /**
+     * S1-F1: an rw-transaction that puts a key and then deletes it keeps the put. The
+     * key exists before, so the delete of RwEnvironment ("Deletes a database entry if it
+     * exists") must leave no entry.
+     */
+    @Nano
+    public static void testRwPutThenDelete() {
+        Database db = Factory.database().memory().start();
+        try {
+            Connection c = db.connection();
+            c.put("/a.txt", "old");
+            c.rw(new Action() {
+                public void run(RwEnvironment env) {
+                    env.put("/a.txt", "new");
+                    env.delete("/a.txt");
+                }
+            });
+            assertGone("rw: put then delete", c.get("/a.txt", String.class));
+        } finally {
+            db.close();
+        }
+    }
+
+    /** S1-F1, the same through WBuilder. */
+    @Nano
+    public static void testWPutThenDelete() {
+        Database db = Factory.database().memory().start();
+        try {
+            Connection c = db.connection();
+            c.put("/b.txt", "old");
+            c.w().put("/b.txt", "new").delete("/b.txt").execute();
+            assertGone("w: put then delete", c.get("/b.txt", String.class));
+        } finally {
+            db.close();
+        }
+    }
