+    /**
+     * S1-F4: a w-transaction (or an rw-transaction) whose only reads are the virtual read of
+     * its objects' directory (RwEnvironmentImp.indexEntries, IndexManager's design note: "we
+     * can get transaction rerun in case an index is added while Connection.set(String,
+     * Object) is being executed") has readTime -1, so its core transaction's lookup time is
+     * Long.MAX_VALUE, and the STM check never finds the directory's virtual hash modified
+     * after it. The steps of RwTransaction.executeRw for WTransaction.execute(), run here
+     * one by one, with an index made between createTrans() and Db.execute(), as another
+     * thread can make it while this one waits for the write lock.
+     */
+    @Nano
+    public static void testObjectPutWithoutReadsMissesNewIndex() {
+        Database database = Factory.database().memory().start();
+        try {
+            ConnectionImp c = (ConnectionImp) database.newConnection();
+            Db db = ((DatabaseImp) database).getDb();
+            IndexManager m = ((DatabaseImp) database).getIndexManager();
+
+            // 1. The w-transaction's preparation: no index for /payments/ yet.
+            RwEnvironmentImp env = new RwEnvironmentImp(c);
+            env.put("/payments/10", new Pay("a", "b"));
+            env.indexEntries(m);
+            Trans t = env.createTrans(db);
+
+            // 2. Meanwhile, another thread: an index on /payments/, made and built.
+            database.indexBuilder("from").type("string/unicode").dir("/payments/")
+                    .field("from").start().join();
+
+            // 3. The w-transaction's commit. Its directory's indexes changed after it read
+            // them: it must be run again (RerunException), as executeRw does.
+            try {
+                db.execute(t);
+            } catch (RerunException e) {
+                return;
+            }
+            Assert.assertTrue("the object", c.get("/payments/10", Pay.class) != null);
+            int n = 0;
+            for (Pay p : c.useIndex("from", Pay.class).objects()) {
+                n++;
+            }
+            Assert.assertEquals("the objects in the index 'from'", 1, n);
+        } finally {
+            database.close();
+        }
+    }
