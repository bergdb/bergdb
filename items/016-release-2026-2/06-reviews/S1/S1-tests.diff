+    /**
+     * S1-F4, with a read: indexEntries reads IndexManager's map first and the previous
+     * value after it, and that read fixes the read time. An index deleted in between
+     * (ensureDeletingState: the map, then storeIndex's commit; then the deletion job) does
+     * not refuse the transaction, which writes an entry into the deleted index's directory
+     * after the deletion: "After this method returns, there should be no more index entries
+     * added to the index directory" (DatabaseImp.deleteIndexInternal). The deletion runs
+     * inside the map read here (a subclass of IndexManager), as another thread can run it
+     * between the two. A new index of the name then holds the old entry.
+     */
+    @Nano
+    public static void testObjectPutWhileIndexIsDeleted() {
+        final Database database = Factory.database().memory().start();
+        try {
+            ConnectionImp c = (ConnectionImp) database.newConnection();
+            Db db = ((DatabaseImp) database).getDb();
+            final IndexManager real = ((DatabaseImp) database).getIndexManager();
+            database.indexBuilder("from").type("string/unicode").dir("/payments/")
+                    .field("from").start().join();
+            IndexManager m = new IndexManager(new BergCollatorFactory()) {
+                public IndexForDir[] getActiveIndexesForDir(String dir) {
+                    IndexForDir[] result = real.getActiveIndexesForDir(dir);
+                    database.deleteIndex("from").join();
+                    return result;
+                }
+            };
+            RwEnvironmentImp env = new RwEnvironmentImp(c);
+            env.put("/payments/10", new Pay("a", "b"));
+            env.indexEntries(m);
+            Trans t = env.createTrans(db);
+            try {
+                db.execute(t);
+            } catch (RerunException e) {
+                return;
+            }
+            // A new index of the name, on another field.
+            database.indexBuilder("from").type("string/unicode").dir("/payments/")
+                    .field("to").start().join();
+            int n = 0;
+            for (Pay p : c.useIndex("from", Pay.class).objects()) {
+                n++;
+            }
+            Assert.assertEquals("the objects in the new index 'from'", 1, n);
+        } finally {
+            database.close();
+        }
+    }
