+    /** AppendOnlyStream refuses negative lengths and its logical length never decreases. */
+    @Nano
+    public static void testR5NegativeAppendDoesNotDecreaseLength() throws IOException {
+        Object lock = new Object();
+        StorageManager manager;
+        synchronized (lock) {
+            manager = new StorageManager.Builder(lock)
+                    .stream("main", new MemoryStream(), 1000, 10).build();
+            manager.syncStreams(new NullProgressListener());
+        }
+        try {
+            boolean refused = false;
+            synchronized (lock) {
+                manager.append(new byte[100], 0, 100);
+                try {
+                    manager.append(new byte[1], 0, -1);
+                } catch (IllegalArgumentException expected) {
+                    refused = true;
+                }
+                Assert.assertTrue("negative append returned normally; manager length="
+                        + manager.getLength() + ", buffer length="
+                        + manager.getMainStream().getLength(), refused);
+                Assert.assertEquals(100, manager.getLength());
+            }
+        } finally {
+            manager.closeAndThrow();
+        }
+    }
