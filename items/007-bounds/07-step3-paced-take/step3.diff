+    /**
+     * The deadline (bergdb 007-03, step 3): a transaction that begins d_h = 2 * sd or more
+     * before the end of the stream is taken whatever the share.
+     */
+    @Nano
+    public static void testDeadline() {
+        TransSeq s = new TransSeq();
+        for (int i = 0; i < 5; i++) {
+            s.add(paceInfo(100 * i, 1000, 100));
+        }
+        // A record of 1 own byte: a share of 5000 * 1 / 500 * 501 / 100 = 50 nodes, less
+        // than a transaction. With sd 100, d_h = 200 takes the transactions at 0 to 300,
+        // 500 to 200 before the end; the one at 400 waits.
+        Assert.assertEquals(300, s.take(-1, 500, 100, 1, IGNORE, Long.MAX_VALUE));
+        Assert.assertEquals(1, s.getSize());
+        Assert.assertEquals(400, s.first.tpos);
+    }
+    
+    /**
+     * A decrease of the setting (bergdb 007-03, step 3): the deadline takes what begins
+     * twice the new setting or more before the end, and the pace takes the rest of the
+     * section down to the new setting in steps. Records of 1000 own bytes and 100 bytes for
+     * each node taken, each a transaction of 10 got-dirty nodes, at sd 100000 and then 25000.
+     */
+    @Nano
+    public static void testDecrease() {
+        final int[] taken = new int[1];
+        final TransNodesForMe counter = new TransNodesForMe() {
+            public void addTopNode(TopNode node) { taken[0]++; }
+            public void addKeyNode(KeyNode node) { taken[0]++; }
+        };
+        TransSeq s = new TransSeq();
+        long length = 0;
+        long sp = -1;
+        int sd = 100000;
+        for (int i = 0; i < 1100; i++) {
+            if (i == 1000) {
+                sd = 25000;
+            }
+            taken[0] = 0;
+            sp = s.take(sp, length, sd, 1000, counter, Long.MAX_VALUE);
+            s.add(paceInfo(length, 10, 1000));
+            Assert.assertTrue("i=" + i, s.first.tpos > length - 2L * sd);     // the deadline
+            length += 1000 + 100 * taken[0];
+            
+            // At the decrease, the section is 100000: the deadline takes the 25 transactions
+            // that begin 50000 or more before the end. Each of the next records takes what
+            // the one before it moved past 50000 (130, 70 and 40 nodes), then the pace takes
+            // its share, at most 20 nodes while the section is below 50000, and at most one
+            // transaction more.
+            if (i == 1000) {
+                Assert.assertEquals(250, taken[0]);
+            }
+            if (i >= 1004) {
+                Assert.assertTrue("i=" + i + ", " + taken[0], taken[0] <= 30);
+            }
+        }
+        Assert.assertEquals(25000, length - sp, 5000);
+    }
