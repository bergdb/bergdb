+        /** Probe (review of P8): lastKeyAt's backward read against a forward scan. */
+        @Nano
+        public static void testProbeBackwardLastKey() {
+            for (int seed = 1; seed <= 6; seed++) {
+                CoreTestClock clock = new CoreTestClock();
+                long time = Clock.UNITS_PER_SEC;
+                clock.setTime(time);
+                Db db = Db.builder().testSetup().maxNodeSize8().clock(clock).start();
+                java.util.Random r = new java.util.Random(seed);
+                java.util.TreeSet<String> live = new java.util.TreeSet<String>();
+                int checks = 0;
+                for (int t = 0; t < 400; t++) {
+                    time += 1000; clock.setTime(time);
+                    Trans.Builder b = db.trans();
+                    int n = 1 + r.nextInt(40);
+                    boolean mass = r.nextInt(10) == 0;
+                    java.util.Set<String> inTrans = new java.util.HashSet<String>();
+                    for (int j = 0; j < n; j++) {
+                        if ((mass || r.nextInt(3) == 0 || (t > 200 && r.nextInt(5) != 0)) && !live.isEmpty()) {
+                            String k = r.nextBoolean() ? live.last() 
+                                    : live.ceiling("/k/" + r.nextInt(1000));
+                            if (k == null) k = live.first();
+                            if (inTrans.add(k)) { b.delete(k); live.remove(k); }
+                        } else {
+                            int len = r.nextInt(4);
+                            String k = "/k/" + r.nextInt(1000) 
+                                    + (len == 0 ? "" : "/" + "abcdefghijklmnopqrstuvwxyz".substring(0, len * 7));
+                            if (inTrans.add(k)) { b.put(k, "v" + t); live.add(k); }
+                        }
+                    }
+                    if (inTrans.isEmpty()) continue;
+                    db.execute(b.build());
+                    
+                    GetMany f = db.newGetMany();
+                    f.stopCondition = new GetMany.GetN(Integer.MAX_VALUE);
+                    f.lookupTime = Long.MAX_VALUE;
+                    db.getMany(f);
+                    GetMany g = db.newGetMany();
+                    g.setBackward();
+                    g.startKey = null;
+                    g.lookupTime = Long.MAX_VALUE;
+                    g.stopCondition = new GetMany.GetN(1);
+                    db.getMany(g);
+                    long[] fl = f.result.isEmpty() ? null : f.result.get(f.result.size() - 1).key;
+                    long[] bl = g.result.isEmpty() ? null : g.result.get(0).key;
+                    if (fl == null || bl == null) {
+                        Assert.assertTrue("seed " + seed + " t " + t, fl == bl);
+                    } else {
+                        Assert.assertTrue("seed " + seed + " t " + t + " " + Arrays.toString(fl)
