+/-- The first record at or after s with a version of y, below a bound. -/
+theorem first_version {S : Stream V T} {s : Nat} {y : NodeId} :
+    ∀ n f0 w0, f0 < s + n → s ≤ f0 → S.versionAt f0 y = some w0 →
