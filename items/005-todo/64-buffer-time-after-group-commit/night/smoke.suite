# bergdb 005-64: the smoke test of run-f53.sh and run-s1.sh, seconds: one scenario of each kind
# of bufftime.suite, tiny, at the three buffer times.

a-100-b20   write  1  n=2000 valsize=100 retain=inf ops=20000 bufftime=20
a-100-b50   write  1  n=2000 valsize=100 retain=inf ops=20000 bufftime=50
a-100-b100  write  1  n=2000 valsize=100 retain=inf ops=20000 bufftime=100

d-t4-b20    write  1  n=2000 commit=durable threads=4 ops=40 warmup=2000 valsize=1000 bufftime=20
d-t4-b50    write  1  n=2000 commit=durable threads=4 ops=40 warmup=2000 valsize=1000 bufftime=50
d-t4-b100   write  1  n=2000 commit=durable threads=4 ops=40 warmup=2000 valsize=1000 bufftime=100
