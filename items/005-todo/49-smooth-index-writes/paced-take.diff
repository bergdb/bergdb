+    /** A transaction with 'count' dirty key nodes and a record of 'ownBytes' (005-49). */
+    private static TransInfo paceInfo(long tpos, long startupPos, long ownBytes, int count) {
+        TransInfo info = newTransInfo(tpos, tpos + 99);
+        info.startupPos = startupPos;
+        info.ownBytes = ownBytes;
+        for (int i = 0; i < count; i++) {
+            KeyNode n = new KeyNode();
+            n.setDirty(true);
+            info.gotDirtyNodes.add(n);
+        }
+        return info;
+    }
+    
+    private static final TransNodesForMe IGNORE = new TransNodesForMe() {
+        public void addTopNode(TopNode node) {}
+        public void addKeyNode(KeyNode node) {}
+    };
+    
+    /** Ten transactions of 10 got-dirty nodes and 100 own bytes each: 0.1 nodes an own byte. */
+    private static TransSeq paceSeq() {
+        TransSeq s = new TransSeq();
+        for (int i = 0; i < 10; i++) {
+            s.add(paceInfo(100 * i, -1, 100, 10));
+        }
+        return s;
+    }
+    
+    /**
+     * The pace (bergdb 005-49): a record takes its share of the section's got-dirty nodes,
+     * whole transactions, and the next with the probability of the part that fits.
+     */
+    @Nano
+    public static void testPace() {
+        // A record of 100 own bytes, a section of 2000 bytes and sd 800: a share of
+        // 0.1 * 100 * 2000 / 800 = 25 nodes, two transactions and half of the third, which
+        // is taken if the hash of the stream's length is below one half.
+        Assert.assertEquals(0.4442, dither(1300), 1e-4);
+        Assert.assertEquals(0.6408, dither(1200), 1e-4);
+        TransSeq s = paceSeq();
+        Assert.assertEquals(200, s.take(1300 - 2000, 1300, 800, 100, IGNORE));
+        Assert.assertEquals(7, s.getSize());
+        s = paceSeq();
+        Assert.assertEquals(100, s.take(1200 - 2000, 1200, 800, 100, IGNORE));
+        Assert.assertEquals(8, s.getSize());
+        
+        // On average a record takes its share: 2.5 transactions.
+        long transactions = 0;
+        for (long length = 10000; length < 20000; length++) {
+            s = paceSeq();
+            s.take(length - 2000, length, 1000000, 100 * 1000000 / 800, IGNORE);
+            transactions += 10 - s.getSize();
+        }
+        Assert.assertEquals(2.5, transactions / 10000.0, 0.02);
+        
+        // A section of half of that, half the share: 12.5 nodes, one transaction and a
+        // quarter of the next, which the hash 0.44 does not take.
+        s = paceSeq();
+        Assert.assertEquals(0, s.take(1300 - 1000, 1300, 800, 100, IGNORE));
+        Assert.assertEquals(9, s.getSize());
+    }
+    
+    /** The deadline (bergdb 007-03, step 3) takes what the pace does not. */
+    @Nano
+    public static void testDeadline() {
+        TransSeq s = new TransSeq();
+        for (int i = 0; i < 5; i++) {
+            s.add(paceInfo(100 * i, i - 10, 100, 1000));
+        }
+        // A record of 1 byte: a share of about 50 nodes, less than a transaction. The
+        // deadline, 2 * 100 before the end, takes the transactions at 0 to 300 whatever the
+        // share.
+        Assert.assertEquals(300, s.take(-1, 500, 100, 1, IGNORE));
+        Assert.assertEquals(1, s.getSize());
+    }
+    
+    /**
+     * The pace's state is a function of the startup section (bergdb 005-49, 010's P2): a
+     * start adds the section's transactions again and gets the same sums and checksum.
+     */
+    @Nano
+    public static void testPaceAfterRestart() {
+        TransInfo[] t = new TransInfo[6];
+        TransSeq s = new TransSeq();
+        t[0] = paceInfo(0, -1, 100, 5);
+        t[1] = paceInfo(100, -1, 200, 5);
+        s.add(t[0]);
+        s.add(t[1]);
+        long sp = s.take(-1, 2199, 1000, 300, IGNORE);     // past the deadline: takes both
+        Assert.assertEquals(100, sp);
+        t[2] = paceInfo(200, sp, 300, 5);                   // the record that took
+        s.add(t[2]);
+        t[3] = paceInfo(500, sp, 50, 5);
+        s.add(t[3]);
+        t[4] = paceInfo(550, sp, 70, 5);
+        s.add(t[4]);
+        t[5] = paceInfo(620, sp, 30, 5);
+        s.add(t[5]);
+        
+        // A start at the startup pos 100 reads the section from t[1]'s record and adds
+        // t[2] to t[5].
+        TransSeq r = new TransSeq();
+        for (int i = 2; i < 6; i++) {
+            TransInfo a = t[i];
+            TransInfo b = paceInfo(a.tpos, a.startupPos, a.ownBytes, 0);
+            b.gotDirtyNodes = a.gotDirtyNodes;
+            r.add(b);
+        }
+        Assert.assertEquals(s.checksum(), r.checksum());
+        Assert.assertEquals(20, r.dirtyCount);
+        Assert.assertEquals(450, r.ownBytes);
+    }
