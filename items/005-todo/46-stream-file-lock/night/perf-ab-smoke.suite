# A tiny suite for perf-ab.sh's smoke test (SMOKE=1): the plumbing of performance.sh ab and
# compare, in about a minute. Its numbers are not measurements. Format of performance.suite.

read-x          read     2   n=5000 nlong=500 valsize=100 history=5000 windows=2 gets=20000 timedgets=10000 scans=200 warmgets=20000
w-x             write    1   n=2000 valsize=100 work=uniform retain=inf ops=10000
