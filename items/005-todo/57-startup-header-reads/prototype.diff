+                if (!Spos.isVpos(pos) && pos < nodeStream.getFirstPos()) {
+                    continue;
+                }
+                counts[0]++;
+                Long id = Spos.isVpos(pos) ? Long.valueOf(pos) : ids.get(pos);
+                Handle live = id != null ? cache.liveHandle(id) : byPos.get(pos);
