+                                + (link ? "links" : "no link") + ", by id "
+                                + (linkById ? "links to the object at " + o.getSpos() : "no link")
+                                + (id != null ? "; the position is in the section's ids" : "")
+                                + (top ? "; a top node" : "");
+                        if (counts[4] <= 10) {
+                            System.err.println(m);
+                        }
+                        assert false : m;
+                    }
+                }
