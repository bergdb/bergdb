+    public void linkToCanonicalByPosition(Node node, Map<Long, Long> ids,
+            Map<Long, Handle> byPos, boolean check, long[] counts) {
+        final int count = node.getSize();
+        final boolean top = node.getType() == Node.TYPE_TOP_NODE;
+
+        for (int i = 0; i < count; i++) {
+            if (!pointsToIndexNode(node, i)) {
