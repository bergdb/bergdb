+        
+        try {
+            Db.builder().testSetup(s.copy()).clock(clock).maxNodeSize30().start();
+            throw new AssertionError("started with node size 30, created with 14");
+        } catch (DbException e) {
+            Assert.assertTrue(e.getMessage(), e.getMessage().contains(
+                    "maximum node size is 14, and this start uses 30."));
+        }
+        
+        db = Db.builder().testSetup(s.copy()).clock(clock).maxNodeSize14().start();
