+        s.append(String.format(Locale.ROOT, " eviction thread %s,", ev == null ? "?" : String.format(Locale.ROOT,
+                "%.0f ms (%.3f cores)", ev, ev / 1000 / sec)));
+        s.append(String.format(Locale.ROOT, " readers %.0f ms (%.2f cores),", rd, rd / 1000 / sec));
+        if (pr != null) {
+            double rest = pr - rd - (ev == null ? 0 : ev);
+            s.append(String.format(Locale.ROOT, " the rest of the process %.0f ms (%.2f cores), process %.2f cores;",
+                    rest, rest / 1000 / sec, pr / 1000 / sec));
+        }
