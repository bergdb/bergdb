+    static final ThreadMXBean MX = ManagementFactory.getThreadMXBean();
+    volatile long evictorId = -1;
+
+    /** The CPU time of the thread bergdb-evictor so far (ns), or -1 if there is none. */
+    long evictorCpu() {
+        if (evictorId < 0) {
+            for (ThreadInfo ti : MX.getThreadInfo(MX.getAllThreadIds(), 0)) {
+                if (ti != null && ti.getThreadName().equals("bergdb-evictor")) evictorId = ti.getThreadId();
+            }
+            if (evictorId < 0) return -1;
+        }
+        return MX.getThreadCpuTime(evictorId);
     }
 
+    /** The CPU time of the process so far (ns), or -1. */
+    static long processCpu() {
+        java.lang.management.OperatingSystemMXBean os = ManagementFactory.getOperatingSystemMXBean();
+        if (os instanceof com.sun.management.OperatingSystemMXBean) {
+            return ((com.sun.management.OperatingSystemMXBean) os).getProcessCpuTime();
+        }
+        return -1;
+    }
